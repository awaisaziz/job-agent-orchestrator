# ─────────────────────────────────────────────────────────────────────────────
# Job Agent Orchestrator — backend configuration
#
# Copy this file to `.env` (in the same backend/ folder) and fill in what you
# have. EVERYTHING IS OPTIONAL: with no keys at all the app still runs end-to-end
# in DEMO MODE — region-aware sample jobs, deterministic resume tailoring, and
# locally-recorded (simulated) applications. Add keys to turn on live features.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider (resume tailoring) ──────────────────────────────────────────
# Set AT LEAST ONE key to enable live LLM tailoring. Without any key the app
# falls back to deterministic (non-LLM) tailoring automatically.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=

# The model the app uses by default. This name is read from the environment and
# shown in the UI. Known models:
#   openai     → gpt-4.1-mini, gpt-4o-mini
#   anthropic  → claude-3-5-sonnet, claude-3-7-sonnet
#   grok       → grok-3-mini, grok-3
# NOTE: If this model's provider has no key but ANOTHER provider does, the app
# auto-selects a working model from the configured provider — so dropping in only
# OPENAI_API_KEY or GROK_API_KEY "just works" without editing this line.
LLM_DEFAULT_MODEL=claude-3-5-sonnet

# Optional: restrict the models offered in the UI dropdown (comma-separated).
# Leave blank to offer every model whose provider key is configured.
# LLM_ENABLED_MODELS=claude-3-5-sonnet,gpt-4o-mini

# Optional LLM tuning
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=1

# ── Job search ───────────────────────────────────────────────────────────────
# Leave JSEARCH_API_KEY blank to search FREE public job boards with NO key
# (Remotive + Arbeitnow + RemoteOK) — real, live web search out of the box.
# Set a JSearch key for Google-for-Jobs coverage with precise location filtering.
# Free JSearch key (200 req/month): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# Comma-separated country codes (used only when a JSearch key is set).
JOB_SEARCH_COUNTRY=us,ca
# JOB_SEARCH_NUM_PAGES=3

# ── Email notifications + HR email applications (Resend) ──────────────────────
# Free key (3,000 emails/month): https://resend.com/api-keys
# Leave blank to skip notification emails (the flow still completes).
RESEND_API_KEY=
# Sandbox sender works with no domain but only delivers to your Resend signup
# email. Verify a domain at https://resend.com/domains for production sending.
RESEND_FROM_EMAIL=Job Agent <onboarding@resend.dev>

# ── Auto-apply behavior ──────────────────────────────────────────────────────
# simulate → record applications locally with a full audit trail (safe default,
#            needs no external services).
# live     → drive the real Playwright/email auto-apply pipeline. Requires
#            `pip install playwright && playwright install chromium` and, for
#            email-apply pages, a RESEND_API_KEY.
AUTO_APPLY_MODE=simulate

# ── Storage / misc (defaults are fine) ───────────────────────────────────────
# DATABASE_URL=sqlite:///./job_agent.db
# AUTO_APPLY_SCREENSHOTS_DIR=storage/screenshots
